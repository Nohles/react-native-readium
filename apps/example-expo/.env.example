# Reader web app (TanStack) — required to open by file id instead of a fixed manifest URL.
# Use your Mac LAN IP on a physical device (not localhost).
EXPO_PUBLIC_READER_WEB_URL=http://localhost:3000

# Fixed proxied manifest (from Reader handoff). Session UUID expires when the proxy restarts.
EXPO_PUBLIC_PROXIED_AUDIOBOOK_MANIFEST_URL=http://localhost:3000/readium/ccdc182a-b20c-406b-a2ed-dfd890d254d5/webpub/QW5keSBXZWlyL1RoZSBNYXJ0aWFuL1RoZSBNYXJ0aWFuLm1wMw/manifest.json

# Optional: open via POST /readium/open/audiobooks/{fileId} instead of the manifest URL above.
EXPO_PUBLIC_AUDIOBOOK_FILE_ID=
