<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev-example app: allow cleartext so Metro is reachable from devices/emulators
         (localhost + 10.0.2.2 for emulators; other hosts via base-config). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
