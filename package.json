{
  "name": "@nohles/react-native-readium",
  "version": "5.0.0-rc.42",
  "description": "A react-native wrapper for https://readium.org/",
  "main": "lib/src/index",
  "types": "lib/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/gradle.properties",
    "ios",
    "web",
    "cpp",
    "nitrogen/generated",
    "nitro.json",
    "scripts/*.rb",
    "app.plugin.js",
    "plugin",
    "react-native-readium.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"./src/**/*.{js,ts,tsx}\" \"./apps/**/src/**/*.{js,ts,tsx}\" \"./apps/example-expo/*.{ts,tsx}\" \"./apps/example-expo/{helpers,screens}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint ./src ./apps/*/src --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "rimraf lib && tsc",
    "prepublishOnly": "pnpm run prepare",
    "release": "release-it",
    "example": "pnpm --filter example-native",
    "example:expo": "pnpm --filter example-expo start",
    "example:nextjs": "pnpm --filter example-nextjs",
    "nitrogen": "nitrogen ./src/specs --config ./nitro.json --out ./nitrogen/generated",
    "pods": "cd apps/example-native && pod-install --quiet",
    "bootstrap": "pnpm install && pnpm run pods",
    "version": "pnpm run changelog && git add CHANGELOG.md",
    "postversion": "pnpm run publish:registry",
    "publish:registry": "pnpm publish --access public --tag rc",
    "publish:npm": "pnpm run publish:registry",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "typecheck:examples": "tsc --noEmit -p apps/example-native/tsconfig.json && tsc --noEmit -p apps/example-expo/tsconfig.json && tsc --noEmit -p apps/example-nextjs/tsconfig.json"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "readium",
    "ebook",
    "epub",
    "ereader",
    "e-reader",
    "read"
  ],
  "repository": "http://github.com/nohles/react-native-readium",
  "author": "Nohles <richienohles@gmail.com> (https://github.com/nohles)",
  "license": "MIT",
  "bugs": {
    "url": "http://github.com/nohles/react-native-readium/issues"
  },
  "homepage": "http://github.com/nohles/react-native-readium#readme",
  "publishConfig": {
    "registry": "http://192.168.1.202:4873/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^17.0.2",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "commitlint": "^17.0.2",
    "conventional-changelog-cli": "^2.2.2",
    "del-cli": "^5.1.0",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^6.0.0",
    "jest": "^29.6.3",
    "nitrogen": "0.37.1",
    "pod-install": "^0.1.0",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.23.2",
    "react-native-nitro-modules": "0.37.1",
    "release-it": "^15.0.0",
    "rimraf": "^5.0.7",
    "turbo": "^1.10.7",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier",
      "unused-imports"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "endOfLine": "auto",
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ],
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "off",
      "unused-imports/no-unused-imports": "error",
      "unused-imports/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_",
          "ignoreRestSiblings": true
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "dependencies": {
    "@readium/css": "^2.0.0",
    "@readium/navigator": "^2.3.0",
    "@readium/navigator-html-injectables": "^2.3.0",
    "@readium/shared": "^2.1.5",
    "use-deep-compare": "^1.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.34.7",
  "stableVersion": "1.2.1"
}
